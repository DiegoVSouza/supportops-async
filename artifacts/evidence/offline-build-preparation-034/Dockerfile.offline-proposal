# Proposal for a future separately authorized validation; not built in phase034.
FROM ghcr.io/astral-sh/uv:0.12.7 AS uv-bin
FROM python:3.13.12-slim AS builder
COPY --from=uv-bin /uv /uvx /bin/
WORKDIR /app
COPY wheelhouse/ /wheelhouse/
COPY locked-runtime-requirements.txt /requirements.txt
RUN uv venv /app/.venv && uv pip install --python /app/.venv/bin/python --offline --no-index --find-links /wheelhouse --require-hashes --no-deps -r /requirements.txt
COPY supportops_async ./supportops_async
FROM python:3.13.12-slim AS runtime
ENV PATH="/app/.venv/bin:$PATH" PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 LLM_MODE=fake PYTHONPATH=/app
WORKDIR /app
RUN groupadd --system --gid 10001 app && useradd --system --uid 10001 --gid app --home-dir /app app
COPY --from=builder --chown=app:app /app /app
USER 10001:10001
EXPOSE 8000
CMD ["uvicorn", "supportops_async.api.runtime:app", "--host", "0.0.0.0", "--port", "8000"]
